# Tor user service (Arti) - systemd unit file
#
# See the LICENSE file at the top of the project tree for copyright
# and license details.

[Unit]
Description=User Tor Service (Arti)
After=network.target
Before=nss-lookup.target
Wants=nss-lookup.target

[Service]
Type=simple
ExecStart=/usr/local/bin/arti --config %h/.config/arti/arti.toml proxy
ExecReload=/bin/kill -HUP $MAINPID
KillSignal=SIGINT
LimitNOFILE=16384

# The service can write its configuration, data, state and cache directories.
# Its view of the rest of the filesystem is read-only apart from private tmp.
NoNewPrivileges=yes
PrivateTmp=yes
ProtectHome=read-only
ProtectSystem=full
ReadOnlyPaths=/
ReadWritePaths=%h/.config/arti
ReadWritePaths=%h/.local/share/arti
ReadWritePaths=%h/.local/state/arti
ReadWritePaths=%h/.cache/arti

[Install]
WantedBy=default.target
